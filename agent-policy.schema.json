{
  "$ref": "#/definitions/AgentPolicy",
  "definitions": {
    "AgentPolicy": {
      "type": "object",
      "properties": {
        "agentPolicyVersion": {
          "type": "string",
          "const": "0.1"
        },
        "issuer": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "keys": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "name",
            "url"
          ],
          "additionalProperties": false
        },
        "default": {
          "type": "string",
          "enum": [
            "deny",
            "allow"
          ],
          "default": "deny"
        },
        "contact": {
          "type": "string",
          "minLength": 1
        },
        "verify": {
          "type": "string",
          "format": "uri"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(\\.[a-z0-9]+)+$"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "door": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "mcp",
                      "openapi"
                    ]
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "type",
                  "url"
                ],
                "additionalProperties": false
              },
              "auth": {
                "type": "string",
                "enum": [
                  "none",
                  "credential"
                ]
              },
              "mandateScope": {
                "type": "string",
                "minLength": 1
              },
              "riskTier": {
                "type": "string",
                "enum": [
                  "auto",
                  "checkpoint"
                ]
              },
              "receipt": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "verify": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              "rateLimit": {
                "type": "object",
                "properties": {
                  "max": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "window": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "max",
                  "window"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "description",
              "door",
              "auth",
              "riskTier"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "agentPolicyVersion",
        "issuer",
        "contact",
        "capabilities"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
